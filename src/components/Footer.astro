---
import Logo from './Logo.astro';
import { nav, services, site } from '../config/site';
---
<footer class="mt-24 border-t border-white/10">
  <div class="wrap grid gap-8 py-12 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm text-silver">Technology for a world of possibilities.</p>
    </div>
    <nav aria-label="Services" class="flex flex-col gap-2 text-sm text-silver">
      {services.map((s) => <a href={`/services/${s.id}`} class="hover:text-cloud">{s.title}</a>)}
    </nav>
    <nav aria-label="Footer" class="flex flex-col gap-2 text-sm text-silver">
      {nav.map((n) => <a href={n.href} class="hover:text-cloud">{n.label}</a>)}
    </nav>
    <div class="flex flex-col gap-2 text-sm text-silver">
      <a href="/get-started" class="hover:text-cloud">Get started</a>
      {site.contactEmail && <a href={`mailto:${site.contactEmail}`} class="hover:text-cloud">{site.contactEmail}</a>}
      {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="hover:text-cloud">WhatsApp</a>}
      {site.location && <span>{site.location}</span>}
      {site.social.map((s) => <a href={s.href} rel="noopener" class="hover:text-cloud">{s.label}</a>)}
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-3 border-t border-white/10 py-6 text-xs text-silver"><span>© {new Date().getFullYear()} CREORBIS</span><span class="flex gap-4"><a href="/privacy" class="hover:text-cloud">Privacy</a><a href="/terms" class="hover:text-cloud">Terms</a></span></div>
</footer>
