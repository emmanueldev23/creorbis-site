---
interface Props { kind: string; }
const { kind } = Astro.props;
const bar = 'rounded bg-white/10';
---
<figure class="rounded-xl border border-white/10 bg-surface/30 p-4" aria-label="Illustrative preview">
  <div aria-hidden="true" class="select-none">
    {kind === 'websites' && (<div class="overflow-hidden rounded-lg border border-white/10 bg-navy">
      <div class="flex gap-1.5 border-b border-white/10 px-3 py-2"><i class="h-2 w-2 rounded-full bg-white/20"></i><i class="h-2 w-2 rounded-full bg-white/20"></i><i class="h-2 w-2 rounded-full bg-white/20"></i></div>
      <div class="space-y-2 p-4"><div class={`${bar} h-3 w-2/3 !bg-cloud/70`}></div><div class={`${bar} h-2 w-1/2`}></div><div class="h-6 w-20 rounded bg-brand"></div>
        <div class="grid grid-cols-3 gap-2 pt-3"><div class="h-16 rounded bg-surface/70"></div><div class="h-16 rounded bg-surface/70"></div><div class="h-16 rounded bg-surface/70"></div></div></div></div>)}
    {kind === 'web-apps' && (<div class="grid grid-cols-[56px_1fr] gap-3 rounded-lg border border-white/10 bg-navy p-3">
      <div class="space-y-2"><div class="h-5 rounded bg-brand/80"></div><div class={`${bar} h-5`}></div><div class={`${bar} h-5`}></div><div class={`${bar} h-5`}></div></div>
      <div><div class="grid grid-cols-3 gap-2"><div class="h-10 rounded bg-surface/70"></div><div class="h-10 rounded bg-surface/70"></div><div class="h-10 rounded bg-surface/70"></div></div>
        <div class="mt-3 flex h-24 items-end gap-2 rounded bg-surface/40 p-2">{[40, 65, 50, 80, 60, 90, 70].map((h) => <div class="flex-1 rounded-sm bg-brand/80" style={`height:${h}%`}></div>)}</div></div></div>)}
    {kind === 'crm' && (<div class="grid grid-cols-4 gap-2 rounded-lg border border-white/10 bg-navy p-3 text-[10px] text-silver">
      {['Lead', 'Contacted', 'Proposal', 'Won'].map((c, i) => (<div><p class="mb-2 font-mono">{c}</p><div class="space-y-2">{Array.from({ length: 3 - (i % 2) }).map((_, j) => <div class="rounded bg-surface/70 p-2"><div class={`${bar} h-1.5 w-4/5`}></div><div class="mt-1.5 h-1.5 w-1/2 rounded bg-aqua/50"></div></div>)}</div></div>))}
    </div>)}
    {kind === 'erp' && (<div class="grid grid-cols-3 gap-2 rounded-lg border border-white/10 bg-navy p-3 text-[11px]">
      {['Inventory', 'Sales', 'Purchasing', 'Accounts', 'People', 'Reports'].map((m, i) => (<div class="rounded bg-surface/70 p-3"><span class="mb-2 block h-1.5 w-1.5 rounded-full bg-aqua"></span><p class="text-cloud">{m}</p><div class={`${bar} mt-2 h-1.5 w-3/4`}></div></div>))}
    </div>)}
    {kind === 'ai' && (<div class="flex flex-wrap items-center gap-2 rounded-lg border border-white/10 bg-navy p-4 text-xs">
      {['Incoming work', 'Automation', 'Human review', 'Done'].map((t, i) => (<><span class:list={['rounded-md px-3 py-2', i === 1 ? 'bg-brand text-white' : 'bg-surface/70 text-cloud']}>{t}</span>{i < 3 && <span class="text-aqua">›</span>}</>))}
    </div>)}
    {kind === 'support' && (<ul class="space-y-2 rounded-lg border border-white/10 bg-navy p-4 text-sm">
      {['Updates applied', 'Bugs fixed', 'Speed checked', 'Help when you need it'].map((t) => <li class="flex items-center gap-3 text-cloud"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#45C8FF" stroke-width="1.8"><path d="M3 8.5l3.2 3L13 4.5"/></svg>{t}</li>)}
    </ul>)}
  </div>
  <figcaption class="mt-3 text-xs text-silver">Illustrative preview</figcaption>
</figure>
