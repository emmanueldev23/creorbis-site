---
interface Props { title: string; updated: string; sections: { h: string; p: string[] }[]; }
const { title, updated, sections } = Astro.props;
---
<section class="wrap max-w-3xl pt-16 pb-4">
  <h1 class="text-4xl font-semibold sm:text-5xl">{title}</h1>
  <p class="mt-3 text-sm text-silver">Last updated {updated}</p>
</section>
<section class="wrap max-w-3xl space-y-8 py-8">
  {sections.map((s) => (
    <div><h2 class="text-xl font-semibold">{s.h}</h2>{s.p.map((t) => <p class="mt-2 text-silver">{t}</p>)}</div>
  ))}
</section>
