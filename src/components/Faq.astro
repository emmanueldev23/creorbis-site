---
interface Props { items: [string, string][]; }
const { items } = Astro.props;
---
<div class="space-y-3">
  {items.map(([q, a], i) => (
    <details class="rv group rounded-lg border border-white/10 px-5 py-4 transition-colors open:bg-surface/30 hover:border-white/20" style={`--d:${i * 50}ms`}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&::-webkit-details-marker]:hidden">
        {q}
        <svg class="shrink-0 text-aqua transition-transform duration-300 group-open:rotate-45" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 3v12M3 9h12"/></svg>
      </summary>
      <p class="mt-3 text-silver">{a}</p>
    </details>
  ))}
</div>
