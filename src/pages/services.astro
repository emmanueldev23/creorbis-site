---
import Base from '../layouts/Base.astro';
import { services } from '../config/site';
---
<Base title="Services | CREORBIS" description="Website development, custom software, AI and automation, and ongoing technical support from CREORBIS.">
  <section class="wrap pt-16 pb-8">
    <h1 class="max-w-3xl text-4xl font-semibold sm:text-5xl">Services</h1>
    <p class="mt-5 max-w-2xl text-lg text-silver">Websites, custom web apps, CRM, ERP, AI and ongoing support, built around how your business works.</p>
  </section>
  <section class="wrap grid gap-5 py-8 md:grid-cols-2 lg:grid-cols-3">
    {services.map((s, i) => (
      <a href={`/services/${s.id}`} class="rv card group flex flex-col rounded-xl p-6" style={`--d:${i * 70}ms`}>
        <h2 class="text-xl font-semibold">{s.title}</h2>
        <p class="mt-3 text-silver">{s.summary}</p>
        <ul class="mt-4 flex-1 space-y-1 text-sm text-silver">{s.includes.slice(0, 3).map((x) => <li class="flex gap-2"><span class="text-aqua" aria-hidden="true">–</span>{x}</li>)}</ul>
        <span class="mt-5 text-sm text-aqua transition-transform group-hover:translate-x-1">Learn more</span>
      </a>
    ))}
  </section>
  <section class="wrap border-t border-white/10 py-12">
    <h2 class="text-2xl font-semibold">How to get started</h2>
    <p class="mt-3 max-w-xl text-silver">Send a short description of what you need. If you’re unsure which service fits, say so and we’ll work it out together.</p>
    <a href="/get-started" class="btn btn-primary mt-6">Get started</a>
  </section>
</Base>
