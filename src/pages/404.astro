---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | CREORBIS">
  <section class="wrap py-28">
    <h1 class="text-4xl font-semibold">Page not found</h1>
    <p class="mt-4 text-silver">That address doesn’t exist. Try the home page or the services list.</p>
    <div class="mt-8 flex gap-3"><a href="/" class="btn btn-primary">Go home</a><a href="/services" class="btn btn-ghost">View services</a></div>
  </section>
</Base>
