---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Mock from '../../components/Mock.astro';
import { services, process, site } from '../../config/site';
export function getStaticPaths() { return services.map((s) => ({ params: { slug: s.id }, props: { s } })); }
const { s } = Astro.props;
const others = services.filter((x) => x.id !== s.id);
const ld = { '@context': 'https://schema.org', '@type': 'Service', name: s.title, description: s.summary, provider: { '@type': 'Organization', name: site.name, url: site.url } };
const d = (i: number) => `--d:${i * 70}ms`;
---
<Base title={`${s.title} | CREORBIS`} description={`${s.summary} ${s.intro}`.slice(0, 158)} jsonLd={ld}>
  <section class="wrap grid items-center gap-10 pt-14 pb-10 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <a href="/services" class="rv text-sm text-silver hover:text-cloud">All services</a>
      <h1 class="rv mt-4 text-4xl font-semibold sm:text-5xl" style="--d:60ms">{s.title}</h1>
      <p class="rv mt-5 max-w-xl text-lg text-silver" style="--d:120ms">{s.intro}</p>
      <div class="rv mt-8 flex flex-wrap gap-3" style="--d:180ms"><a href={`/contact?service=${s.id}`} class="btn btn-primary">Get a quote</a><a href="/pricing" class="btn btn-ghost">See pricing</a></div>
    </div>
    <div class="rv" style="--d:240ms"><Mock kind={s.id} /></div>
  </section>
  <section class="wrap grid gap-10 border-t border-white/10 py-12 lg:grid-cols-2">
    <div><h2 class="rv text-xl font-semibold">What’s included</h2>
      <ul class="mt-4 space-y-2">{s.includes.map((x, i) => <li class="rv flex gap-3" style={d(i)}><span class="text-aqua" aria-hidden="true">–</span><span class="text-silver">{x}</span></li>)}</ul></div>
    <div><h2 class="rv text-xl font-semibold">What you get</h2>
      <ul class="mt-4 space-y-2">{s.features.map((x, i) => <li class="rv flex gap-3" style={d(i)}><span class="text-aqua" aria-hidden="true">–</span><span class="text-silver">{x}</span></li>)}</ul></div>
  </section>
  <section class="wrap grid gap-6 pb-12 md:grid-cols-2">
    <div class="rv card rounded-xl p-6"><h2 class="font-medium">Who it’s for</h2><p class="mt-2 text-silver">{s.audience}</p></div>
    <div class="rv card rounded-xl p-6" style="--d:90ms"><h2 class="font-medium">The problem it solves</h2><p class="mt-2 text-silver">{s.solves}</p></div>
  </section>
  <section class="wrap border-t border-white/10 py-12">
    <h2 class="rv text-2xl font-semibold">How it works</h2>
    <ol class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{process.map((p, i) => (
      <li class="rv card rounded-lg bg-surface/40 p-5" style={d(i)}><span class="font-mono text-sm text-aqua">{i + 1}</span><h3 class="mt-3 font-medium">{p.title}</h3><p class="mt-1 text-sm text-silver">{p.text}</p></li>
    ))}</ol>
  </section>
  <section class="wrap max-w-3xl py-12"><h2 class="rv mb-6 text-2xl font-semibold">Common questions</h2><Faq items={s.faq as [string, string][]} /></section>
  <section class="wrap py-10"><h2 class="rv text-lg font-medium">Other services</h2>
    <div class="mt-4 flex flex-wrap gap-3">{others.map((o) => <a href={`/services/${o.id}`} class="rv rounded-full border border-white/15 px-4 py-2 text-sm text-silver transition-colors hover:border-aqua/50 hover:text-cloud">{o.title}</a>)}</div>
  </section>
</Base>
